# config.env 範本——複製成 config.env 後填入你自己的值，勿提交 config.env
# 載入方式：set -a; . ./config.env; set +a; python3 digest.py
LINE_CHANNEL_ACCESS_TOKEN=<你的 long-lived channel access token>
DIGEST_TARGET_USER_ID=<你的 LINE userId，U 開頭 33 字，不是 Channel ID>
DEDUP_DIR=<去重狀態資料夾的純本機路徑，例 /Users/你/ednews/dedup>
ARCHIVE_DIR=<存檔資料夾；要接 C 就指到 Drive 同步路徑，或留空不存檔>
AI_PROVIDER=none          # none | claude | openai
AI_API_KEY=<僅 claude/openai 需要；none 留空>
